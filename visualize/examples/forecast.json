      {"op":"*","args":[2,{"op":"*","args":[{"var":"views"},{"var":"scenario"}]}]},
      {"op":"*","args":[3,{"op":"*","args":[{"var":"views"},{"var":"scenario"}]}]},
      {"op":"*","args":[4,{"op":"*","args":[{"var":"views"},{"var":"scenario"}]}]},
      {"op":"*","args":[5,{"op":"*","args":[{"var":"views"},{"var":"scenario"}]}]},
      {"op":"*","args":[6,{"op":"*","args":[{"var":"views"},{"var":"scenario"}]}]},
      {"op":"*","args":[7,{"op":"*","args":[{"var":"views"},{"var":"scenario"}]}]}
    ]}]},
    {"type":"button","label":"重置参数","action":"reset"}
  ]
}
